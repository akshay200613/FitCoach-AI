{
  "name": "ai-personal-fitness-trainer",
  "version": "1.0.0",
  "description": "FitCoach AI - AI-Powered Personal Fitness Trainer Application",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "dev": "npm run dev --prefix client",
    "start": "uvicorn api.index:app --host 0.0.0.0 --port 5000",
    "start:fastapi": "uvicorn api.index:app --host 0.0.0.0 --port 5000 --reload",
    "start:node": "node server/index.js",
    "test:fastapi": "python test_fastapi.py",
    "test:api": "node server/test_integration.js"
  },
  "keywords": [
    "fitness",
    "ai",
    "trainer",
    "workout-planner",
    "health",
    "nutrition"
  ],
  "author": "FitCoach AI Team",
  "license": "MIT"
}
